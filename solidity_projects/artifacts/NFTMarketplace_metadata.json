				"delistNFT(uint256)": {
					"details": "下架NFT",
					"params": {
						"listingId": "挂单ID"
					}
				},
				"endAuction(uint256)": {
					"details": "结束拍卖",
					"params": {
						"auctionId": "拍卖ID"
					}
				},
				"getAuction(uint256)": {
					"details": "查询拍卖信息",
					"params": {
						"auctionId": "拍卖ID"
					},
					"returns": {
						"active": "是否激活",
						"endTime": "结束时间",
						"highestBid": "当前最高出价",
						"highestBidder": "当前最高出价者",
						"nftContract": "NFT合约地址",
						"seller": "卖家地址",
						"startPrice": "起拍价",
						"tokenId": "Token ID"
					}
				},
				"getListing(uint256)": {
					"details": "查询挂单信息",
					"params": {
						"listingId": "挂单ID"
					},
					"returns": {
						"active": "是否激活",
						"nftContract": "NFT合约地址",
						"price": "价格",
						"seller": "卖家地址",
						"tokenId": "Token ID"
					}
				},
				"listNFT(address,uint256,uint256)": {
					"details": "上架NFT",
					"params": {
						"nftContract": "NFT合约地址",

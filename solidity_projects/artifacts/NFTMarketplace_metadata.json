					"details": "出价事件"
				},
				"NFTDelisted(uint256)": {
					"details": "NFT下架事件"
				},
				"NFTListed(uint256,address,address,uint256,uint256)": {
					"details": "NFT上架事件"
				},
				"NFTSold(uint256,address,address,uint256)": {
					"details": "NFT售出事件"
				},
				"PriceUpdated(uint256,uint256)": {
					"details": "价格更新事件"
				}
			},
			"kind": "dev",
			"methods": {

# =========================
# 新手一键流程配置示例
# 文件名可复制为 .env 使用
# =========================

# ---- 网络与合约地址 ----
RPC_URL=http://127.0.0.1:7545
AUCTION_ADDRESS=0x1425616FA72279dDB7D52C3Dcc422C88a5f46417
NFT_ADDRESS=0xfb6BD90083539F235fc3422f44F6c29f78B23932
PAYMENT_TOKEN=0x1B295D69069a97213c0df6f126F2E3285Bc54713
ORACLE_ADDRESS=0xA4E9FF68672b7d38A9b8B9388A86b21fb858163e

# ---- 角色私钥（替换成你 Ganache 的账户私钥）----
# 管理员：用于 set-oracle / start（通常也是部署者）
ADMIN_PRIVATE_KEY=0xYourAdminPrivateKey
# 卖家：用于 mint-nft / approve-nft（NFT 持有者）
SELLER_PRIVATE_KEY=0xYourSellerPrivateKey
# 出价人：用于 bid-eth
BIDDER_PRIVATE_KEY=0xYourBidderPrivateKey
# 结束者：用于 end，不填则默认用 ADMIN_PRIVATE_KEY
ENDER_PRIVATE_KEY=0xYourEnderPrivateKey

# ---- 可选：显式指定卖家地址 ----
# 不填则脚本自动使用 SELLER_PRIVATE_KEY 推导地址
SELLER_ADDRESS=0xYourSellerAddress

# ---- 拍卖参数 ----
NFT_ID=1
STARTING_PRICE_USD=1000
DURATION_SEC=300
BID_AMOUNT_ETH=0.1

# ---- 可选：强制指定拍卖ID ----
# 一般不填，脚本自动用最新拍卖（auctionId - 1）
# AUCTION_ID=0

# ---- end 步骤辅助 ----
# true: 本地链自动快进时间并挖块（推荐 Ganache 开启）
AUTO_TIME_TRAVEL=true
# 若不想快进，可设置等待秒数（仅当 AUTO_TIME_TRAVEL=false 时有意义）
END_WAIT_SEC=0

# 复制为 .env 后填入真实值，或在系统中导出同名环境变量。
# Hardhat 3 亦可用: npx hardhat keystore set SEPOLIA_RPC_URL

# 主网
#SEPOLIA_RPC_URL=https://mainnet.infura.io/v3/0f53e2340e33474e9416b4a9301dfecd

# 测试网
#SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/0f53e2340e33474e9416b4a9301dfecd
# 钱包里面的私钥
#SEPOLIA_PRIVATE_KEY=909fe76c6bf4aa72b1a7960674e6b880198f70e7aa196dac4f49f2bbd9aa0975

# 本地 Ganache（临时用于本地部署）
SEPOLIA_RPC_URL=http://127.0.0.1:7545
SEPOLIA_PRIVATE_KEY=0xb92fb8110313c000c82ad3489679571478627c139d8ee77b922a872bcb913828
SEPOLIA_PRIVATE_KEY2=0xac5905979318923ae061b71a05234123ff1f21a98f9d93b88a5c55b46d302653
SEPOLIA_PRIVATE_KEY3=0x882a8f9914ea8e3517344cc2f6ca02174f0a5390b677e56f2747729668e0cff3
SEPOLIA_PRIVATE_KEY4=0x6d97696a8927e04b04441a17757d0373c4e768b218e308d0920869adc7f3d712
SEPOLIA_PRIVATE_KEY5=0x8a4ee8e81f677d0d97b9ebd9687d443601836539b7cdf69e84278cc7738a71c3


# ---- 网络与合约地址 ----
RPC_URL=http://127.0.0.1:7545
AUCTION_ADDRESS=0x1425616FA72279dDB7D52C3Dcc422C88a5f46417
PRIVATE_KEY=0xb92fb8110313c000c82ad3489679571478627c139d8ee77b922a872bcb913828
NFT_ADDRESS=0xfb6BD90083539F235fc3422f44F6c29f78B23932
PAYMENT_TOKEN=0x1B295D69069a97213c0df6f126F2E3285Bc54713
ORACLE_ADDRESS=0xA4E9FF68672b7d38A9b8B9388A86b21fb858163e

# ---- 角色私钥（替换成你 Ganache 的账户私钥）----
# 管理员：用于 set-oracle / start（通常也是部署者）
ADMIN_PRIVATE_KEY=0xb92fb8110313c000c82ad3489679571478627c139d8ee77b922a872bcb913828
# 卖家：用于 mint-nft / approve-nft（NFT 持有者）
SELLER_PRIVATE_KEY=0xac5905979318923ae061b71a05234123ff1f21a98f9d93b88a5c55b46d302653
# 出价人：用于 bid-eth
BIDDER_PRIVATE_KEY=0x882a8f9914ea8e3517344cc2f6ca02174f0a5390b677e56f2747729668e0cff3
# 结束者：用于 end，不填则默认用 ADMIN_PRIVATE_KEY
ENDER_PRIVATE_KEY=

# ---- 可选：显式指定卖家地址 ----
# 不填则脚本自动使用 SELLER_PRIVATE_KEY 推导地址
SELLER_ADDRESS=

# ---- 拍卖参数 ----
NFT_ID=1
STARTING_PRICE_USD=1000
DURATION_SEC=300
BID_AMOUNT_ETH=0.1

# ---- 可选：强制指定拍卖ID ----
# 一般不填，脚本自动用最新拍卖（auctionId - 1）
# AUCTION_ID=0

# ---- end 步骤辅助 ----
# true: 本地链自动快进时间并挖块（推荐 Ganache 开启）
AUTO_TIME_TRAVEL=true
# 若不想快进，可设置等待秒数（仅当 AUTO_TIME_TRAVEL=false 时有意义）
END_WAIT_SEC=0


